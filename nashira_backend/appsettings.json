{
  "DataProtection": {
    "KeyRingPath": "./keyring"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=nashira;Username=nashira;Password=nashira"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Jwt": {
    "Issuer": "nashira",
    "Audience": "nashira-api",
    "Key": "dev-only-key-replace-in-prod-with-32plus-random-bytes-via-env",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AiChat": {
    "StreamDeadlineSeconds": 240,
    "DeadlineWarnPercent": 75,
    "MaxIterations": 50,
    "MaxToolResultChars": 100000,
    "HistoryCharBudget": 60000
  },
  "Python": {
    "Executable": "python3",
    "PipExecutable": "pip3",
    "SshRunnerPath": "/usr/local/lib/nashira_python/nashira_ssh_runner.py",
    "PackagesDir": "/app/pyenv",
    "PackageProvisioningEnabled": true,
    "PipOnlyBinary": true,
    "ProvisionIntervalSeconds": 15,
    "PipInstallTimeoutSeconds": 300
  },
  "Git": {
    "Root": "./data/git",
    "MaxFileBytes": 5242880,
    "DefaultAuthorName": "nashira",
    "DefaultAuthorEmail": "nashira@localhost"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "FromAddress": "",
    "FromName": "nashira"
  },
  "Ssh": {
    "AllowDestructiveCommands": false
  },
  "Ai": {
    "//SelfBaseUrl": "Where this backend reaches itself, used by the built-in Specs/*.yaml so execute_operation can call Nashira's own API. Empty means http://localhost:8080, the container's own Kestrel, which is correct for every stock deployment; set it only when the backend answers somewhere else. Give the origin only, no /api - the shipped spec paths already carry it. The bearer is the calling user's own session token, so the agent can never reach anything that user cannot; it is only ever sent to this address.",
    "SelfBaseUrl": ""
  }
}
