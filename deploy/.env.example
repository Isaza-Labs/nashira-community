# nashira — deployment environment.
#
# Copy this to `.env` in the SAME directory (deploy/.env); Docker Compose loads it
# automatically for variable interpolation. Do NOT commit the real `.env`.
#
# Quick start:
#   cp .env.example .env
#   #  -> set a strong JWT_KEY (required) and a real POSTGRES_PASSWORD, then:
#   docker compose up -d --build
#   #  -> create the first admin (Production has no seeded user);
#     the response returns the generated username + initial_password:
#   curl -X POST "http://localhost:8080/api/auth/bootstrap"
#   #  -> then open the app in a browser:  http://localhost:3000
#
# Every value below maps to an appsettings key via the ASP.NET `__` convention
# (e.g. Jwt__Key overrides Jwt:Key). Anything left unset falls back to the
# defaults shown here / in nashira_backend/appsettings.json.

# ── Required ────────────────────────────────────────────────────────────────
# JWT signing secret. Must be 32+ chars of high entropy. The backend REFUSES to
# boot in Production with a short or known-default key. Generate one with:
#   openssl rand -base64 48
JWT_KEY=

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_DB=nashira
POSTGRES_USER=nashira
# Change this for any non-local deployment.
POSTGRES_PASSWORD=nashira
# Host port for Postgres. Only used if you uncomment the `ports:` mapping on
# the db service — by default Postgres is not published to the host at all.
POSTGRES_PORT=5433

# ── Runtime ─────────────────────────────────────────────────────────────────
# Production | Development. Development seeds an admin/admin account and relaxes
# the JWT-key check — never use it for a real deployment. On a server use
# Production and create the first admin via POST /api/auth/bootstrap.
ASPNETCORE_ENVIRONMENT=Production

# Optional deployment capability allowlist. Leave this variable undefined to
# preserve the existing all-enabled behaviour. To restrict a deployment,
# uncomment the example and list every required dependency explicitly:
# NASHIRA_MODULES=chat,ai-studio,integrations,secrets
#
# `core` is always enabled. `ai-studio` requires `integrations`; `chat` requires
# `ai-studio`; `communications` requires `chat`. Transitive dependencies must
# also be listed. An empty NASHIRA_MODULES= is invalid, and changing the list
# requires recreating the backend container.
#
# What a deployment is actually running is reported by GET /api/modules and by
# the `deployment.modules.*` lines in the boot log — not by this file, which may
# have been edited since the container started. Disabling a capability never
# deletes its data, so restoring the previous value and recreating the container
# brings it back as it was. QUICK_START.md §2 has the full procedure.

# Host port for the backend API. The frontend reaches it internally (container
# network); expose it for direct API access / health / scalar.
BACKEND_PORT=8080

# ── Frontend (SvelteKit — its own container) ────────────────────────────────
# Host port the app is served on — this is the URL you open in the browser.
FRONTEND_PORT=3006
# Public origin the app is reached at (SvelteKit CSRF / origin check). Must match
# FRONTEND_PORT; set to the real hostname when behind a domain or reverse proxy.
FRONTEND_ORIGIN=http://localhost:3006

# ── Messaging channels (Slack / Telegram / WhatsApp / Teams) ────────────────
# Public base URL of the app, used for two things on admin → Messaging
# channels: the webhook URL an admin registers with the provider, and the
# `/link?token=…` URL the bot DMs an unlinked user so they can bind their
# account. Defaults to FRONTEND_ORIGIN, which is normally what you want.
# Override only when the provider has to reach the app at a different hostname
# than people browse to — a tunnel (cloudflared, ngrok) or a reverse proxy.
# Providers will not call an address they cannot resolve, so localhost works
# for Slack Socket Mode and the Teams Azure Relay, but not for a real webhook.
# MESSAGING_PUBLIC_BASE_URL=https://nashira.example.com

# ── Network / trusted proxies (optional) ────────────────────────────────────
# Proxies whose X-Forwarded-For the backend honours when resolving the real
# client IP (login rate limiter, audit/auth-event trails). Defaults to the
# compose network's fixed subnet, i.e. the frontend container's proxy hop.
# Comma-separated CIDRs and/or single IPs. Empty = trust nothing (client IP is
# the immediate peer — every browser request then looks like the frontend
# container).
# TRUSTED_PROXIES=172.27.0.0/16
# Number of proxy hops between the browser and the backend. 1 = the shipped
# frontend proxy. Add 1 for each extra proxy in front (nginx, cloudflared, ALB).
# FORWARD_LIMIT=1
# Compose network subnet; keep TRUSTED_PROXIES in sync if you change it.
# COMPOSE_SUBNET=172.27.0.0/16

# ── JWT (optional) ──────────────────────────────────────────────────────────
JWT_ISSUER=nashira
JWT_AUDIENCE=nashira-api
# Access-token lifetime (minutes) and rotating refresh-token lifetime (days).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ── Email / SMTP (optional; disabled by default) ────────────────────────────
# Set SMTP_ENABLED=true and fill in host + from address to enable the email tool.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USESSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=nashira

# ── SSH runner (optional) ───────────────────────────────────────────────────
# Allow the agent's SSH runner to execute destructive / configuration commands.
# Keep false unless you accept the blast radius on managed devices.
SSH_ALLOW_DESTRUCTIVE=false

# ── Logging (optional) ──────────────────────────────────────────────────────
# Console sink format:
#   pretty → colored one-liners, best for `docker logs` or a terminal
#   json   → CLEF one-event-per-line (good for Loki / Elastic / Datadog)
# Unset auto-picks: pretty in Development, json otherwise.
# LOG_FORMAT=pretty
#
# EF Core SQL (Microsoft.EntityFrameworkCore.Database.Command). Default Warning
# = silent (errors/timeouts only). Set Information to see every query + timing
# while hunting N+1 / slow queries — very noisy; revert when done.
# LOG_EF_SQL=Warning
#
# Application-services tree (nashira_backend.Services.*: workflow / worker /
# engine / integration / device / credential / auth / policy / ssh / scheduler).
# Information = the "what is the platform doing" timeline. Debug = per-iteration
# and per-device detail. Warning = state changes and errors only.
# The `.Services.Ai` chat/agent subtree is pinned to Debug regardless (longest
# prefix wins) since it's the hottest surface for diagnosing agent behaviour.
# LOG_ACTIONS=Information
#
# Dumps every raw SSE chunk received from the LLM provider at Debug. The chunks
# can contain prompt text — triage only, never leave on in production.
# AI_LOG_PAYLOADS=false
