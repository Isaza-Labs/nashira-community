# syntax=docker/dockerfile:1.7

# nashira frontend — SvelteKit on the Node adapter, run as its own service
# (`node build` on :3000). Offline-capable; for air-gapped builds, vendor the
# node deps or point npm at an internal registry.
FROM node:22-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
# .git is not in the build context, so the docs version stamp takes its commit and
# date from here (vite.config.ts); empty values fall back to "unknown" / build day.
ARG NASHIRA_BUILD_COMMIT=
ARG NASHIRA_BUILD_DATE=
ENV NODE_ENV=production \
    NASHIRA_BUILD_COMMIT=$NASHIRA_BUILD_COMMIT \
    NASHIRA_BUILD_DATE=$NASHIRA_BUILD_DATE
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN npm run build \
 && npm prune --omit=dev

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

COPY --from=build --chown=node:node /app/build         ./build
COPY --from=build --chown=node:node /app/node_modules  ./node_modules
COPY --from=build --chown=node:node /app/package.json  ./package.json

USER node
EXPOSE 3000

CMD ["node", "build"]
